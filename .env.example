APP_ORIGIN=http://localhost:3000
# Explicit local simulation; npm run demo sets it for that process only. Never real Tide evidence.
TIDE_SIMULATION=false
SIMULATION_DATABASE_PATH=./data/simulation.sqlite
DATABASE_PATH=./data/vault.sqlite
# Exact public adapter exported by Dinh; embedded jwk.keys required. Never use remote JWKS.
TIDECLOAK_ADAPTER_PATH=./data/tidecloak.json
# Optional additional aud constraint. azp must always equal adapter.resource.
TIDECLOAK_EXPECTED_AUDIENCE=
# Optional: accept roles from this exact client in addition to realm roles.
TIDECLOAK_ROLE_CLIENT=
# No upload is enabled until Dinh confirms an opaque envelope's maximum overhead.
# Example only: 131072 bytes. This is NOT the 16384-byte browser plaintext limit.
MAX_CIPHERTEXT_BYTES=
DEMO_ATTACKS_ENABLED=false
# Fixed release recipient, never taken from the request body.
INVIGILATOR_ISSUER=
INVIGILATOR_SUBJECT=
# Optional evidence; exact immutable image digest only, never a registry credential.
TIDECLOAK_REALM_IMAGE_DIGEST=
# Optional reviewed HTTPS console, opened by a governor in their own browser.
NEXT_PUBLIC_TIDE_CONSOLE_URL=
# Optional proposal/read service only, after live least-privilege review. Never use a bootstrap admin.
TIDE_PROPOSAL_CLIENT_ID=
TIDE_PROPOSAL_CLIENT_SECRET=
TIDE_BRIDGE_REVIEW_PATH=
